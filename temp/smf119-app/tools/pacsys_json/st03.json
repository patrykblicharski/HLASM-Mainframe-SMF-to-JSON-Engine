        {
          "offset": 4,
          "name": "SMF119FLG",
          "length": "1",
          "format": "binary",
          "description": "System indicator Bit Meaning When Set 0 New record format 1 Subtypes used 2 Reserved. 3-6 Version indicators* 7 System is running in PR/SM mode.*See \u201cStandard SMF Record Header\u201d on page 13-1 for a detailed description.",
          "reserved": false
