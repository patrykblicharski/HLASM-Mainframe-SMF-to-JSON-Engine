  "panels": [
    {
      "title": "Step ends (30-4) \u2014 program / step / class / CPU",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  step_name, program_name, job_class, racf_user,\n  cpu_step_time AS cpu_timer, step_comp_code\nFROM smf.smf_30_4 WHERE $__timeFilter(event_date) AND job_name = '$job'\nORDER BY event_date DESC, time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Primary step/program source. Subtype 5 often blanks these fields."
    },
    {
      "title": "Job ends (30-5)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  racf_user, step_comp_code, cpu_step_time AS cpu_timer\nFROM smf.smf_30_5 WHERE $__timeFilter(event_date) AND job_name = '$job'\nORDER BY event_date DESC, time DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Dataset I/O for $job",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT 'INPUT' AS direction,\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  ddname, if(trim(BOTH ' ' FROM dsname)='','(no dsname)',dsname) AS dsname, volser_1, excp_count\nFROM smf.smf_14 WHERE $__timeFilter(event_date) AND job_name='$job'\nUNION ALL\nSELECT 'OUTPUT' AS direction,\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  ddname, if(trim(BOTH ' ' FROM dsname)='','(no dsname)',dsname) AS dsname, volser_1, excp_count\nFROM smf.smf_15 WHERE $__timeFilter(event_date) AND job_name='$job'\nORDER BY event_ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "RACF for $job",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  user_id, event_code, class_name,\n  nullIf(old_resource,'') AS old_resource,\n  nullIf(access_requested,'') AS access_requested,\n  nullIf(access_allowed,'') AS access_allowed\nFROM smf.smf_80 WHERE $__timeFilter(event_date) AND job_name='$job'\nORDER BY event_date DESC, time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "User detail",
              "url": "/d/smf-user-detail?var-user=${__data.fields.user_id}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    }
  ],
