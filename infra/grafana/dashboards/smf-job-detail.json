  "panels": [
    {
      "title": "30-5 ends for $job",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT event_date, time, step_name, program_name, job_class, racf_user, cpu_step_time, step_comp_code\nFROM smf.smf_30_5 WHERE event_date>=today()-4 AND job_name = '$job'\nORDER BY event_date DESC, time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Dataset I/O for $job",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT 'INPUT' AS direction, event_date, time, ddname,\n  if(trim(BOTH ' ' FROM dsname)='','(no dsname)',dsname) AS dsname, volser_1, excp_count\nFROM smf.smf_14 WHERE event_date>=today()-4 AND job_name='$job'\nUNION ALL\nSELECT 'OUTPUT', event_date, time, ddname, if(trim(BOTH ' ' FROM dsname)='','(no dsname)',dsname), volser_1, excp_count\nFROM smf.smf_15 WHERE event_date>=today()-4 AND job_name='$job'\nORDER BY event_date DESC, time DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "RACF for $job",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT event_date, time, user_id, event_code, class_name, old_resource, access_requested, access_allowed\nFROM smf.smf_80 WHERE event_date>=today()-4 AND job_name='$job'\nORDER BY event_date DESC, time DESC LIMIT 200"
        }
      ],
