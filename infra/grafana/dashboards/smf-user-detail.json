  "panels": [
    {
      "title": "RACF events for $user",
      "type": "table",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT event_date, time, job_name, event_code, class_name, old_resource, access_requested, access_allowed\nFROM smf.smf_80 WHERE event_date>=today()-4 AND user_id='$user'\nORDER BY event_date DESC, time DESC LIMIT 300"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Jobs for RACF user $user (30)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT job_name, count() AS ends, sum(toUInt64OrZero(cpu_step_time)) AS cpu_sum\nFROM smf.smf_30_5 WHERE event_date>=today()-4 AND (racf_user='$user' OR user_id_field='$user')\nGROUP BY job_name ORDER BY ends DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    }
  ],
