    {
      "title": "Hourly pulse (multi-type)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT hour AS time, series, sum(cnt) AS value FROM (\n  SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS hour, 'INPUT-14' AS series, count() AS cnt FROM smf.smf_14 WHERE $__timeFilter(event_date) GROUP BY hour\n  UNION ALL\n  SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS hour, 'OUTPUT-15' AS series, count() AS cnt FROM smf.smf_15 WHERE $__timeFilter(event_date) GROUP BY hour\n  UNION ALL\n  SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS hour, 'RACF-80' AS series, count() AS cnt FROM smf.smf_80 WHERE $__timeFilter(event_date) GROUP BY hour\n  UNION ALL\n  SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS hour, 'TCP-119-2' AS series, count() AS cnt FROM smf.smf_119_2 WHERE $__timeFilter(event_date) GROUP BY hour\n  UNION ALL\n  SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS hour, 'JOB-30-5' AS series, count() AS cnt FROM smf.smf_30_5 WHERE $__timeFilter(event_date) GROUP BY hour\n) GROUP BY time, series ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "spanNulls": true,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Uses dashboard time range. Aliased UNION branches for ClickHouse 24.8."
    },
