      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT sum(row_count) AS value FROM smf.stats_records_daily WHERE $__timeFilter(event_date)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Total rows",
          "thresholds": {
