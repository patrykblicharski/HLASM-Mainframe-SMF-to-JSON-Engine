          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT event_date, table_name, smf_system_id, sum(row_count) AS rows\nFROM smf.stats_records_daily\nWHERE event_date >= today() - 10\nGROUP BY event_date, table_name, smf_system_id\nORDER BY event_date DESC, rows DESC\nLIMIT 200"
