  "panels": [
    {
      "title": "Job ends by hour (30-5)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS time, count() AS ends FROM smf.smf_30_5 WHERE $__timeFilter(event_date) GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "spanNulls": true,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "title": "Job class mix (30-4 step end)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT if(job_class='','(blank)',job_class) AS job_class, count() AS steps\nFROM smf.smf_30_4 WHERE $__timeFilter(event_date) GROUP BY job_class ORDER BY steps DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Class comes from SMF 30-4 \u2014 subtype 5 often leaves job_class/program blank in dumps."
    },
    {
      "title": "Top jobs (30-5 ends + 30-4 programs)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT e.job_name, e.ends, coalesce(p.with_program, 0) AS with_program,\n  coalesce(p.with_step, 0) AS with_step, coalesce(p.cpu_timer_sum, 0) AS cpu_timer_sum\nFROM (\n  SELECT job_name, count() AS ends FROM smf.smf_30_5 WHERE $__timeFilter(event_date) AND job_name!='' GROUP BY job_name\n) e\nLEFT JOIN (\n  SELECT job_name,\n         countIf(program_name!='') AS with_program,\n         countIf(step_name!='') AS with_step,\n         sum(toUInt64OrZero(cpu_step_time)) AS cpu_timer_sum\n  FROM smf.smf_30_4 WHERE $__timeFilter(event_date) AND job_name!='' GROUP BY job_name\n) p USING (job_name)\nORDER BY e.ends DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "cpu_timer_sum = sum(SMF cpu_step_time) from 30-4, raw timer units from the record."
    },
    {
      "title": "Programs / steps (from 30-4)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT nullIf(program_name,'') AS program_name, nullIf(step_name,'') AS step_name, count() AS steps\nFROM smf.smf_30_4 WHERE $__timeFilter(event_date) AND (program_name!='' OR step_name!='')\nGROUP BY program_name, step_name ORDER BY steps DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Step-end records (30-4) carry program/step; 30-5 job-end often does not in this dump."
    },
    {
      "title": "CPU timer sum by job (30-4, top 15)",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT job_name, sum(toUInt64OrZero(cpu_step_time)) AS cpu_timer_sum\nFROM smf.smf_30_4 WHERE $__timeFilter(event_date) AND job_name!=''\nGROUP BY job_name ORDER BY cpu_timer_sum DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": "Raw SMF cpu_step_time units (not wall-clock seconds)."
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "smf",
    "jobs",
    "30"
  ],
