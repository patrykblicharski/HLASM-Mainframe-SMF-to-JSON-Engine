      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT (if((SELECT count() FROM smf.smf_119_3 WHERE $__timeFilter(event_date))+(SELECT count() FROM smf.smf_119_70 WHERE $__timeFilter(event_date))=0, 0, 1) AS value"
