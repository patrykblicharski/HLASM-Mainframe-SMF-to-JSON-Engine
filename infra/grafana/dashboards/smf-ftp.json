    {
      "title": "FTP bytes / day",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT toDateTime(event_date) AS time, direction, sum(bytes_sum) AS bytes FROM smf.stats_ftp_daily WHERE $__timeFilter(event_date) GROUP BY time, direction ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 45,
            "spanNulls": true,
            "lineWidth": 2
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Empty when dump has no subtype 3/70."
    },
    {
      "title": "Available 119 subtypes",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT '119-1' AS subtype, count() AS rows FROM smf.smf_119_1 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-2', count() FROM smf.smf_119_2 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-5', count() FROM smf.smf_119_5 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-6', count() FROM smf.smf_119_6 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-10', count() FROM smf.smf_119_10 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-3', count() FROM smf.smf_119_3 WHERE $__timeFilter(event_date)\nUNION ALL SELECT '119-70', count() FROM smf.smf_119_70 WHERE $__timeFilter(event_date)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Top FTP users",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT direction, local_user, sum(bytes_sum) AS bytes, sum(xfer_count) AS transfers FROM smf.stats_ftp_daily WHERE $__timeFilter(event_date) GROUP BY direction, local_user ORDER BY bytes DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    }
