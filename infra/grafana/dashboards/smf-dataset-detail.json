  "panels": [
    {
      "title": "I/O for $dsname",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT 'INPUT' AS direction,\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  job_name, ddname, volser_1, excp_count\nFROM smf.smf_14 WHERE $__timeFilter(event_date) AND dsname='$dsname'\nUNION ALL\nSELECT 'OUTPUT' AS direction,\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  job_name, ddname, volser_1, excp_count\nFROM smf.smf_15 WHERE $__timeFilter(event_date) AND dsname='$dsname'\nORDER BY event_ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Scratches / catalog / RACF",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT 'SCRATCH' AS kind,\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  job_name, volume_serial AS detail FROM smf.smf_17 WHERE $__timeFilter(event_date) AND dsname='$dsname'\nUNION ALL SELECT 'DEFINE',\n  concat(toString(event_date),' ',if(time='','00:00:00',time)),\n  job_name, catalog_name FROM smf.smf_61 WHERE $__timeFilter(event_date) AND entry_name='$dsname'\nUNION ALL SELECT 'DELETE',\n  concat(toString(event_date),' ',if(time='','00:00:00',time)),\n  job_name, catalog_name FROM smf.smf_65 WHERE $__timeFilter(event_date) AND entry_name='$dsname'\nUNION ALL SELECT 'RACF',\n  concat(toString(event_date),' ',if(time='','00:00:00',time)),\n  job_name, concat(user_id,' EVT',event_code) FROM smf.smf_80 WHERE $__timeFilter(event_date) AND old_resource='$dsname'\nORDER BY event_ts DESC LIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    }
  ],
