  "panels": [
    {
      "title": "Terminations / hour",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT hour AS time, sum(conn_count) AS connections FROM smf.stats_tcp_hourly WHERE $__timeFilter(hour) GROUP BY hour ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "spanNulls": true,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "title": "Bytes in/out / hour",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT hour AS time, sum(in_bytes) AS in_bytes, sum(out_bytes) AS out_bytes FROM smf.stats_tcp_hourly WHERE $__timeFilter(hour) GROUP BY hour ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "spanNulls": true,
            "lineWidth": 2
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "title": "Top remote IPs",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT remote_ip, count() AS conns, sum(toUInt64OrZero(in_bytes)) AS in_bytes, sum(toUInt64OrZero(out_bytes)) AS out_bytes\nFROM smf.smf_119_2 WHERE $__timeFilter(event_date) AND remote_ip!=''\nGROUP BY remote_ip ORDER BY conns DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "IP detail",
              "url": "/d/smf-ip-detail?var-ip=${__data.fields.remote_ip}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Termination codes",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT if(term_code='','(blank)',term_code) AS term_code, count() AS conns FROM smf.smf_119_2 WHERE $__timeFilter(event_date) GROUP BY term_code ORDER BY conns DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": ""
    },
    {
      "title": "Local ports (119-1)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT local_port, count() AS conns FROM smf.smf_119_1 WHERE $__timeFilter(event_date) AND local_port!='' GROUP BY local_port ORDER BY conns DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Top workloads (resource/AS)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT if(resource_name='',as_name,resource_name) AS job_name, count() AS conns,\n  sum(toUInt64OrZero(in_bytes)+toUInt64OrZero(out_bytes)) AS bytes\nFROM smf.smf_119_2 WHERE $__timeFilter(event_date)\nGROUP BY job_name ORDER BY bytes DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "smf",
    "tcp",
    "119"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-4d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "SMF TCP (119-1/2)",
  "uid": "smf-tcp",
  "version": 4,
  "refresh": "5m"
}