  "panels": [
    {
      "title": "RACF events & failed logons (EVT 1)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT toStartOfHour(parseDateTimeBestEffort(concat(toString(event_date),' ',if(time='','00:00:00',time)))) AS time,\n  count() AS events, countIf(event_code='1') AS failed_logon\nFROM smf.smf_80 WHERE $__timeFilter(event_date) GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 18,
            "spanNulls": true,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": ""
    },
    {
      "title": "Event codes",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT concat('EVT ', event_code) AS event_code, count() AS events FROM smf.smf_80 WHERE $__timeFilter(event_date) GROUP BY event_code ORDER BY events DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": ""
    },
    {
      "title": "Top users",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT user_id, count() AS events FROM smf.smf_80 WHERE $__timeFilter(event_date) AND user_id!='' GROUP BY user_id ORDER BY events DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "User detail",
              "url": "/d/smf-user-detail?var-user=${__data.fields.user_id}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Top jobs",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT job_name, count() AS events FROM smf.smf_80 WHERE $__timeFilter(event_date) AND job_name!='' GROUP BY job_name ORDER BY events DESC LIMIT 40"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": ""
    },
    {
      "title": "Class mix",
      "type": "bargauge",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT if(class_name='','(blank)',class_name) AS class_name, count() AS events FROM smf.smf_80 WHERE $__timeFilter(event_date) GROUP BY class_name ORDER BY events DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "description": ""
    },
    {
      "title": "Recent events",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_smf"
      },
      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  concat(toString(event_date),' ',if(time='','00:00:00',time)) AS event_ts,\n  date AS smf_date, time AS smf_time,\n  user_id, job_name, event_code, class_name,\n  nullIf(old_resource,'') AS old_resource,\n  nullIf(access_requested,'') AS access_requested,\n  nullIf(access_allowed,'') AS access_allowed\nFROM smf.smf_80 WHERE $__timeFilter(event_date)\nORDER BY event_date DESC, time DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "User detail",
              "url": "/d/smf-user-detail?var-user=${__data.fields.user_id}&from=${__from}&to=${__to}"
            },
            {
              "title": "Job detail",
              "url": "/d/smf-job-detail?var-job=${__data.fields.job_name}&from=${__from}&to=${__to}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "old_resource / access_* are sparse in many dumps; event_ts always from date+time."
    }
  ],
  "schemaVersion": 39,
