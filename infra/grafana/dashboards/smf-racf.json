      "targets": [
        {
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT user_id, sum(row_count) AS events\nFROM smf.stats_racf_daily\nWHERE event_date >= today() - 10\nGROUP BY user_id\nORDER BY events DESC\nLIMIT 40"
